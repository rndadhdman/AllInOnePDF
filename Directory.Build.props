<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Authors>AllInOne PDF contributors</Authors>
    <Product>AllInOne PDF</Product>
    <Copyright>Copyright (c) 2026 AllInOne PDF contributors</Copyright>
    <!-- The release workflow overrides this from the tag (v1.2.3 -> 1.2.3); see .github/workflows/release.yml and CHANGELOG.md. -->
    <Version>1.2.1</Version>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <!-- CA1305: interpolated StringBuilder.Append of strings/ints; CA1416: pdfium/Skia calls are guarded by the supported-OS set we ship. -->
    <NoWarn>$(NoWarn);CA1848;CA2007;CA1031;CA1062;CA1308;CA1812;CA1822;CA1054;CA1056;CA1724;CA1707;CA1515;CA2227;CA1002;CA1819;CA1711;CA1716;CA1720;CA1305;CA1416</NoWarn>
  </PropertyGroup>

</Project>
