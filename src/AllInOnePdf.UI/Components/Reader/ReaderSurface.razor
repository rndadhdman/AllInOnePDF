@* Reflow reading surface: the rendered document inside a scroll container, with reading progress and scroll-spy. *@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IHostServices Host
@using Microsoft.Extensions.Logging
@inject ILogger<ReaderSurface> Logger

<div class="rd-surface @(Settings.Justify ? "rd-justify" : null) @(ReaderViewSettings.IsDarkPalette(Settings.Palette) ? "rd-dark" : "rd-light")"
     style="@Settings.ToCssVariables()">
    <div class="rd-progress" role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="rd-progress-fill" @ref="_progress"></div>
    </div>
    <div class="rd-scroll" @ref="_scroller" data-reader-scroll tabindex="0" role="document" aria-label="@AriaLabel" lang="@Language">
        <div class="rd-column">
            @((MarkupString)Html)
        </div>
    </div>
</div>

@code {
    private const string ModulePath = "./_content/AllInOnePdf.UI/Components/Reader/ReaderSurface.razor.js";

    /// <summary>HTML fragment from <see cref="IDocumentHtmlRenderer"/> (trusted: text is encoded by the renderer).</summary>
    [Parameter, EditorRequired] public string Html { get; set; } = string.Empty;

    /// <summary>Effective typography and palette.</summary>
    [Parameter, EditorRequired] public ReaderViewSettings Settings { get; set; } = new();

    /// <summary>BCP 47 language of the document, for hyphenation and screen readers.</summary>
    [Parameter] public string? Language { get; set; }

    [Parameter] public string AriaLabel { get; set; } = "Document";

    /// <summary>Scroll fraction to restore whenever <see cref="Html"/> changes.</summary>
    [Parameter] public double? RestoreFraction { get; set; }

    /// <summary>Reports the scroll fraction (debounced). A plain delegate so scrolling never re-renders the parent.</summary>
    [Parameter] public Action<double>? OnScrollFraction { get; set; }

    [Parameter] public EventCallback<string?> OnActiveHeading { get; set; }

    private ElementReference _scroller;
    private ElementReference _progress;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<ReaderSurface>? _self;
    private string? _renderedHtml;
    private string? _appliedHtml;
    private ReaderViewSettings? _renderedSettings;
    private double? _keepFraction;
    private bool _disposed;

    protected override async Task OnParametersSetAsync()
    {
        // Typography changes reflow the text: remember where the reader was so the position survives.
        if (_handle is not null && _renderedSettings is not null && !Equals(_renderedSettings, Settings) && ReferenceEquals(_renderedHtml, Html))
        {
            try
            {
                _keepFraction = await _handle.InvokeAsync<double>("getFraction");
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }
    }

    protected override bool ShouldRender() =>
        !ReferenceEquals(_renderedHtml, Html) || !Equals(_renderedSettings, Settings);

    protected override void OnAfterRender(bool firstRender)
    {
        _renderedHtml = Html;
        _renderedSettings = Settings;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            if (firstRender)
            {
                _self = DotNetObjectReference.Create(this);
                _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
                _handle = await _module.InvokeAsync<IJSObjectReference>("create", _scroller, _progress, _self);
            }

            if (_handle is null)
            {
                return;
            }

            if (!ReferenceEquals(_appliedHtml, Html))
            {
                _appliedHtml = Html;
                _keepFraction = null;
                await _handle.InvokeVoidAsync("refresh", RestoreFraction ?? 0);
            }
            else if (_keepFraction is { } keep)
            {
                _keepFraction = null;
                await _handle.InvokeVoidAsync("keepPosition", keep);
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    /// <summary>Scrolls a heading into view (respects reduced motion). Falls back to the global helper.</summary>
    public async Task ScrollToIdAsync(string id)
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeAsync<bool>("scrollToId", id);
            }
            else
            {
                await JS.InvokeAsync<bool>("aio.scrollToId", id);
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>Current scroll fraction (0..1), or null when not available.</summary>
    public async Task<double?> GetFractionAsync()
    {
        try
        {
            return _handle is null ? null : await _handle.InvokeAsync<double>("getFraction");
        }
        catch (JSDisconnectedException)
        {
            return null;
        }
        catch (JSException)
        {
            return null;
        }
    }

    [JSInvokable("OnScrollFraction")]
    public void OnScrollFractionFromJs(double fraction) => OnScrollFraction?.Invoke(fraction);

    [JSInvokable("OnActiveHeading")]
    public Task OnActiveHeadingFromJs(string? id) => OnActiveHeading.InvokeAsync(id);

    /// <summary>A web or mail link in the document was clicked: open it with the host (system browser / mail app).</summary>
    [JSInvokable("OnExternalLink")]
    public async Task OnExternalLinkFromJs(string url)
    {
        // The script already filtered; check again because anything can call a JSInvokable.
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri)
            || (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps && uri.Scheme != Uri.UriSchemeMailto))
        {
            return;
        }

        try
        {
            await Host.OpenUrlAsync(uri.AbsoluteUri);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or System.ComponentModel.Win32Exception)
        {
            Logger.LogWarning(ex, "Opening a link from the document failed");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }

        _self?.Dispose();
    }
}
