@* Fast preview: document HTML on simulated pages, styled by CSS generated from the working theme. Click an element to edit it. *@
@implements IAsyncDisposable
@inject IDocumentHtmlRenderer HtmlRenderer
@inject ThemeBuilderState State
@inject IJSRuntime JS
@inject IHostServices Host

<div class="tb-canvas" @ref="_root" tabindex="0" aria-label="Fast preview. Click an element to open its settings; Escape clears the selection.">
    @((MarkupString)_style)
    <div class="tb-stage @_scope">
        @((MarkupString)_html)
        <div class="tb-overlay" aria-hidden="true"></div>
    </div>
</div>

@code {
    [Parameter] public Document? Document { get; set; }
    /// <summary>Identifies the document (sample kind); a change re-renders the HTML immediately.</summary>
    [Parameter] public string DocumentKey { get; set; } = string.Empty;
    [Parameter] public int Version { get; set; }
    [Parameter] public int? TotalPages { get; set; }
    /// <summary>"fit" or a scale factor such as "0.75".</summary>
    [Parameter] public string Zoom { get; set; } = "fit";
    [Parameter] public EventCallback<PreviewSelection> OnSelect { get; set; }

    private readonly string _scope = "tbp-" + Guid.NewGuid().ToString("N")[..10];
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<BuilderPreview>? _self;
    private CancellationTokenSource? _debounce;
    private string _style = string.Empty;
    private string _html = string.Empty;
    private string? _fragment;
    private string? _fragmentKey;
    private int _renderedVersion = -1;
    private int? _renderedPages;
    private string? _appliedZoom;
    private double _appliedWidth;
    private bool _disposed;

    protected override void OnParametersSet()
    {
        if (Document is null || State.Working is null)
        {
            return;
        }

        var docChanged = !string.Equals(_fragmentKey, DocumentKey, StringComparison.Ordinal);
        if (docChanged)
        {
            // Same image policy as the Reader: embedded and local images are inlined (local files only on the desktop
            // host, or next to the document), remote images are never fetched.
            // The prepared copy splits quote attributions and marks default callout titles like the PDF renderer.
            _fragment = HtmlRenderer.RenderFragment(ThemeBuilderPreview.PrepareDocument(Document), new HtmlRenderOptions
            {
                BlockIndexes = true,
                HeadingAnchors = false,
                ExternalLinksBlank = false,
                ResolveImage = ReaderImageResolver.Create(allowLocalFiles: Host.Kind == HostKind.Desktop),
            });
            _fragmentKey = DocumentKey;
        }

        if (docChanged || _renderedVersion < 0 || _renderedPages != TotalPages)
        {
            Rebuild();
        }
        else if (Version != _renderedVersion)
        {
            _ = DebounceAsync();
        }
    }

    private async Task DebounceAsync()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
        var cts = _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(150, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (_disposed || cts.IsCancellationRequested)
        {
            return;
        }

        await InvokeAsync(() =>
        {
            Rebuild();
            StateHasChanged();
        });
    }

    private void Rebuild()
    {
        if (Document is null || State.Working is null || _fragment is null)
        {
            return;
        }

        var theme = State.Working;
        _style = "<style>" + ThemeBuilderCssGenerator.Generate(theme, _scope) + "</style>";
        _html = ThemeBuilderPreview.Compose(Document, _fragment, theme, TotalPages);
        _renderedVersion = State.Version;
        _renderedPages = TotalPages;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }

        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AllInOnePdf.UI/Components/ThemeBuilder/BuilderPreview.razor.js");
                _self = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("init", _root, _self);
            }
            catch (JSDisconnectedException)
            {
                return;
            }
            catch (JSException)
            {
                // Click-to-select is an enhancement; the preview still renders without it.
                return;
            }
        }

        var width = PageWidthPx();
        if (_module is not null && (_appliedZoom != Zoom || Math.Abs(_appliedWidth - width) > 0.5))
        {
            _appliedZoom = Zoom;
            _appliedWidth = width;
            try
            {
                await _module.InvokeVoidAsync("setZoom", _root, Zoom, width);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    public async Task ClearSelectionAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("clearSelection", _root);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    [JSInvokable]
    public Task OnPreviewSelected(string group, string? sub, string label) =>
        InvokeAsync(() => OnSelect.InvokeAsync(new PreviewSelection(group, sub, label)));

    private double PageWidthPx() => (State.Working?.Page.GetSizeMm().WidthMm ?? 210) * 96 / 25.4;

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _debounce?.Cancel();
        _debounce?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _root);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
        }

        _self?.Dispose();
    }
}
