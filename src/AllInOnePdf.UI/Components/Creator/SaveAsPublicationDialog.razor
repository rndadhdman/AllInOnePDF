@* Body of the "Save as" dialog: asks for the copy's name. *@
@implements IDialogContentComponent<SaveAsPublicationModel>

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
        <FluentTextField @bind-Value="Content.Name" Label="Publication name" Immediate="true" Required="true" Style="width:100%" autofocus />
        <FluentLabel Color="Color.Neutral">@(Content.NeverSaved
            ? "This publication has not been saved yet. It is saved under this name and stays open for editing."
            : "The copy is saved as a new publication and opens for editing. The original keeps its last saved state.")</FluentLabel>
    </FluentStack>
</FluentDialogBody>

@code {
    [Parameter] public SaveAsPublicationModel Content { get; set; } = new();
}
