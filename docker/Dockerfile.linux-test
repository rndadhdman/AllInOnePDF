# Builds the solution and runs the test suite on Linux.
#   docker build -f docker/Dockerfile.linux-test -t allinonepdf-test .
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ENV DOTNET_NOLOGO=1 DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1

# Native dependencies for SkiaSharp / pdfium.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libfontconfig1 libfreetype6 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props AllInOnePdf.slnx ./
COPY src/AllInOnePdf.Core/AllInOnePdf.Core.csproj src/AllInOnePdf.Core/
COPY src/AllInOnePdf.UI/AllInOnePdf.UI.csproj src/AllInOnePdf.UI/
COPY src/AllInOnePdf.Web/AllInOnePdf.Web.csproj src/AllInOnePdf.Web/
COPY src/AllInOnePdf.Desktop/AllInOnePdf.Desktop.csproj src/AllInOnePdf.Desktop/
COPY tests/AllInOnePdf.Core.Tests/AllInOnePdf.Core.Tests.csproj tests/AllInOnePdf.Core.Tests/
RUN dotnet restore AllInOnePdf.slnx

COPY . .
RUN dotnet build AllInOnePdf.slnx -c Release --no-restore
RUN dotnet test tests/AllInOnePdf.Core.Tests/AllInOnePdf.Core.Tests.csproj -c Release --no-build --logger "console;verbosity=normal"
